{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":dependencyDashboard",
    "group:allNonMajor"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions pinned in build scripts via '# renovate:' comments",
      "managerFilePatterns": ["/^build_files/.+\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( extractVersion=(?<extractVersion>\\S+))?\\s+\\w+_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"]
    }
  ]
}
